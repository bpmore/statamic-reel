{
    "name": "bpmore/statamic-reel",
    "description": "Caption and transcript governance for the video and audio on a Statamic site. Reel does not generate captions: it checks the ones you have, edits them, and refuses to publish media without them.",
    "keywords": [
        "statamic",
        "accessibility",
        "a11y",
        "wcag",
        "captions",
        "webvtt",
        "transcript"
    ],
    "license": "proprietary",
    "type": "statamic-addon",
    "homepage": "https://hada.farm",
    "authors": [
        {
            "name": "Brent Passmore",
            "homepage": "https://hada.farm"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "statamic/cms": "^6.27"
    },
    "require-dev": {
        "orchestra/testbench": "^10.11 || ^11.0",
        "pestphp/pest": "^3.8 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Bpmore\\Reel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bpmore\\Reel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "extra": {
        "statamic": {
            "name": "Reel",
            "slug": "statamic-reel"
        },
        "laravel": {
            "providers": [
                "Bpmore\\Reel\\ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
